# Public frontend configuration belongs in .env.local, not this backend file.
# Set APP_URL to the full public frontend origin used by checkout callbacks.
APP_URL=http://127.0.0.1:5175

# Supabase project URL (SUPABASE_URL falls back to VITE_SUPABASE_URL).
SUPABASE_URL=
# Server-only Supabase secret/service-role key. Never use a publishable key here.
SUPABASE_SECRET_KEY=

# Paystack secret key; use a test key for controlled testing.
PAYSTACK_SECRET_KEY=

# Resend transactional email configuration.
RESEND_API_KEY=
EMAIL_FROM=

# Protects POST /api/internal/ticket-confirmations/retry.
CRON_SECRET=

PORT=3001
